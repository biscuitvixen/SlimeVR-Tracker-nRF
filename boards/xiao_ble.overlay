/* === Seeed XIAO nRF52840 (non-Sense) — Smol Slime overlay === */

 / {
	/* Firmware reads GPIOs from here */
	zephyr,user {
		/* IMU interrupt on D3 / P0.29 (active-low) */
		int0-gpios = <&gpio0 29 GPIO_ACTIVE_LOW>;
		/* External IMU clock enable on D1 / P0.03 (if used) */
		clk-gpios  = <&gpio0 3 GPIO_ACTIVE_HIGH>;
	};

	/* Battery sense divider — use literals, not expressions */
	battery-divider {
		compatible = "voltage-divider";
		status = "okay";
		io-channels = <&adc 7>;
		output-ohms = <510000>;
		full-ohms   = <1510000>; /* 1M + 510k */
		power-gpios = <&gpio0 14 (GPIO_OPEN_DRAIN|GPIO_ACTIVE_LOW)>;
	};

	/* Aliases some firmware paths use */
	aliases {
		imu = &imu_spi; /* DT_ALIAS(imu) -> SPI IMU node */
		mag = &mag;     /* DT_ALIAS(mag) -> I2C magnetometer node */
	};
 }; /* <-- terminate root node */

/*
 * ---- SPI3 for IMU ----
 * D8  = P1.13 = SCK
 * D9  = P1.14 = MISO
 * D10 = P1.15 = MOSI
 * D2  = P0.28 = CS
 *
 * Using SPI3 avoids the SPIM1/TWIM1 instance clash with I²C1.
 */
&pinctrl {
	spi3_default: spi3_default {
		group1 {
			psels = <NRF_PSEL(SPIM_SCK,  1, 13)>,
			        <NRF_PSEL(SPIM_MOSI, 1, 15)>,
			        <NRF_PSEL(SPIM_MISO, 1, 14)>;
		};
	};
	spi3_sleep: spi3_sleep {
		group1 {
			psels = <NRF_PSEL(SPIM_SCK,  1, 13)>,
			        <NRF_PSEL(SPIM_MOSI, 1, 15)>,
			        <NRF_PSEL(SPIM_MISO, 1, 14)>;
			low-power-enable;
		};
	};
};

&spi3 {
	status = "okay";
	pinctrl-0 = <&spi3_default>;
	pinctrl-1 = <&spi3_sleep>;
	pinctrl-names = "default", "sleep";

	/* GPIO CS (D2 / P0.28) */
	cs-gpios = <&gpio0 28 GPIO_ACTIVE_LOW>;

	/* Minimal child so the generic binding accepts it */
	imu_spi: imu_spi@0 {
		compatible = "vnd,spi-device";
		reg = <0>;                    /* CS index */
		spi-max-frequency = <8000000>;
		label = "imu-spi";
	};
};

/*
 * ---- I²C1 for magnetometer (QMC6309 @ 0x0D) ----
 * Board pinctrl is already set for I²C1 on XIAO BLE.
 */
&i2c1 {
	mag: mag@0d {
		compatible = "i2c-device";
		reg = <0x0d>;
		label = "qmc6309";
	};
}; /* terminate referenced node */

/* ---- Disable / remove unused peripherals ---- */
 /delete-node/ &uart0;
 /delete-node/ &spi2;
 /delete-node/ &qspi;
&cryptocell { status = "disabled"; };
&nfct       { status = "disabled"; };
